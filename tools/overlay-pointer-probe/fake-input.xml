<?xml version="1.0" encoding="UTF-8"?>
<protocol name="fake_input">
  <copyright><![CDATA[
    SPDX-FileCopyrightText: 2015 Martin Gräßlin

    SPDX-License-Identifier: LGPL-2.1-or-later
  ]]></copyright>
  <!-- Copied from KDE's plasma-wayland-protocols (src/protocols/fake-input.xml) for this spike only: the client below
       is a test tool that talks to a private nested KWin whose permission checks are off. Reduced to the requests the
       spike uses; the request order (hence the opcodes) is the upstream order. -->
  <interface name="org_kde_kwin_fake_input" version="6">
      <request name="authenticate">
          <arg name="application" type="string"/>
          <arg name="reason" type="string"/>
      </request>
      <request name="pointer_motion">
          <arg name="delta_x" type="fixed"/>
          <arg name="delta_y" type="fixed"/>
      </request>
      <request name="button">
        <arg name="button" type="uint"/>
        <arg name="state" type="uint"/>
      </request>
      <request name="axis">
        <arg name="axis" type="uint"/>
        <arg name="value" type="fixed"/>
      </request>
      <request name="touch_down" since="2">
         <arg name="id" type="uint"/>
         <arg name="x" type="fixed"/>
         <arg name="y" type="fixed"/>
      </request>
      <request name="touch_motion" since="2">
          <arg name="id" type="uint"/>
          <arg name="x" type="fixed"/>
          <arg name="y" type="fixed"/>
      </request>
      <request name="touch_up" since="2">
          <arg name="id" type="uint"/>
      </request>
      <request name="touch_cancel" since="2"/>
      <request name="touch_frame" since="2"/>
      <request name="pointer_motion_absolute" since="3">
          <arg name="x" type="fixed"/>
          <arg name="y" type="fixed"/>
      </request>
      <request name="keyboard_key" since="4">
        <arg name="button" type="uint"/>
        <arg name="state" type="uint"/>
      </request>
      <request name="destroy" type="destructor" since="5"/>
      <request name="keyboard_keysym" since="6">
        <arg name="keysym" type="uint"/>
        <arg name="state" type="uint"/>
      </request>
  </interface>
</protocol>
